rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminTenantId() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.keys().hasAll(['tenantId'])
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.tenantId
        : 'kakinadamart';
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.tenantId == adminTenantId();
      allow update: if isAdmin()
        && resource.data.tenantId == adminTenantId()
        && request.resource.data.tenantId == adminTenantId();
      allow delete: if isAdmin()
        && resource.data.tenantId == adminTenantId();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['tenantId', 'customer', 'items', 'total', 'status', 'createdAt'])
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId.size() > 0
        && request.resource.data.status == 'new'
        && request.resource.data.customer.keys().hasAll(['name', 'phone', 'address']);
      allow read: if isAdmin()
        && resource.data.tenantId == adminTenantId();
      allow update: if isAdmin()
        && resource.data.tenantId == adminTenantId()
        && request.resource.data.tenantId == adminTenantId();
      allow delete: if isAdmin()
        && resource.data.tenantId == adminTenantId();
    }

    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
